# Public canonical origin. Set only after the real domain is known.
SITE_URL=
# Keep previews out of search; enable only after content and launch review.
ALLOW_INDEXING=false

# Optional public JSON endpoint: { "eyebrow": "...", "description": "..." }.
# Content integration is a proposed contract, not an installed WordPress plugin.
WORDPRESS_CONTENT_URL=

# Disabled until the existing WordPress gateway plugins and bridge are verified.
ENABLE_CHECKOUT=false
# Base HTTPS bridge URL, expected to expose POST /requests.
WORDPRESS_API_URL=
# Server-only credential; enter securely, never commit a real value here.
WORDPRESS_API_TOKEN=
# Comma-separated exact HTTPS origins; no trailing slash, path or wildcard.
CHECKOUT_ALLOWED_ORIGINS=

# Transactional SMS via Melipayamak shared service template; server-only.
# Requires the WordPress durable claim/result endpoints documented in README.
ENABLE_MELIPAYAMAK=false
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# Approved BaseServiceNumber template variables, in order: firstName;reference.
MELIPAYAMAK_REGISTRATION_BODY_ID=
