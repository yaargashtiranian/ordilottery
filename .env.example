# Supabase project connection; use a publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Allowed email for the first backoffice account; its editor membership is managed in Supabase.
BACKOFFICE_ADMIN_EMAIL=

# Public canonical origin. Set only after the real domain is known.
SITE_URL=
# Keep previews out of search; enable only after content and launch review.
ALLOW_INDEXING=false

# Direct checkout is unavailable until its provider and verification flow are implemented.
ENABLE_CHECKOUT=false

# Transactional SMS via Melipayamak shared service template; server-only.
# Automatic sends remain disabled until a durable Supabase notification claim is implemented.
ENABLE_MELIPAYAMAK=false
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# Approved BaseServiceNumber template variables, in order: firstName;reference.
MELIPAYAMAK_REGISTRATION_BODY_ID=

# Server-only AES-256-GCM key: 32 random bytes encoded as 64 hexadecimal characters.
# Preserve this key in secure environment settings and a separate recovery secret store.
# Changing/losing it makes existing encrypted documents and recovery copies unreadable.
# Missing key disables document uploads; never prefix it with NEXT_PUBLIC_.
DOCUMENTS_ENCRYPTION_KEY=
